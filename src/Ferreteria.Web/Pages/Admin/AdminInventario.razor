@page "/admin/inventario"
@attribute [Authorize(Roles = "Admin")]
@inject IProductoApi ProductoApi


<PageTitle>Inventario</PageTitle>


<h1>Inventario</h1>

@if (error is not null)
{
    <div class="alert alert-danger" role="alert">
        @error
        <button class="btn btn-sm btn-outline-danger ms-2" @onclick="CargarAsync">Reintentar</button>
    </div>
}


@if (cargando)
{
    <p><em>Cargando Productos...</em></p>
}
else{

    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card text-center">
                <div class="card-body">
                    <div class="text-body-secondary small">Total stock</div>
                    <div class="fs-4 fw-semibold">@Inventario</div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card text-center">
                <div class="card-body">
                    <div class="text-body-secondary small"> Total $ </div>
                    <div class="fs-4 fw-semibold">@TotalDinero.ToString("N0", Cultura)</div>
                </div>
            </div>
        </div>
    </div>



    <div class="card">
        <div class="card-body">
            <h5 class="card-title mb-3">Unidades por producto</h5>

            @if (_productos.Count == 0)
            {
                <p class="text-body-secondary mb-0"><em>No hay productos activos.</em></p>
            }
            else
            {
                foreach (var p in PorStock)
                {
                    <div class="fila-barra">
                        <span class="nombre">@p.Nombre</span>
                        <div class="pista">
                            <div class="barra" style="width:@Porcentaje(p)%"></div>
                        </div>
                        <span class="valor">@p.Stock</span>
                    </div>
                }
            }
        </div>
    </div>
}
    



@code{

    private static readonly System.Globalization.CultureInfo Cultura = new("es-CO");

    private bool cargando = true;
    private string? error;
    private List<ProductoDto> _productos = new();


    private IEnumerable<ProductoDto> PorStock => _productos.OrderByDescending(p => p.Stock);
    private int Maximo => _productos.Count == 0 ? 1 : Math.Max(1, _productos.Max(p => p.Stock));
    private int Porcentaje(ProductoDto p) => (int)Math.Round(p.Stock * 100.0 / Maximo);


    public int Inventario => _productos.Sum(p => p.Stock);
    public decimal TotalDinero => _productos.Sum(p => p.PrecioUnitario * p.Stock);



    protected override async Task OnInitializedAsync() => await CargarAsync();

    private async Task CargarAsync()
    {
        cargando = true;
        error = null;
        try
        {
            _productos = await ProductoApi.ObtenerTodosAsync();
        }
        catch (ApiException ex)
        {
            error = ex.Message;
        }
        catch (HttpRequestException)
        {
            error = "No se pudo conectar con el servidor.";
        }
        finally
        {
            cargando = false;
        }
    }
}
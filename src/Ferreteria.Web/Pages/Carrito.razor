@page "/carrito"
@implements IDisposable
@inject ICarritoService CarritoServicio
@inject IVentaApi VentaApi
@inject NavigationManager Navegador
@inject AuthenticationStateProvider AuthProvider

<PageTitle>Carrito</PageTitle>

<h1>Mi carrito</h1>

@if (items.Count == 0)
{
    <p>
        Tu carrito está vacío.
        <a href="catalogo">Ver el catálogo</a>
    </p>
}
else
{
    <table class="table align-middle">
        <thead>
            <tr>
                <th>Producto</th>
                <th class="text-end">Precio</th>
                <th style="width: 140px;">Cantidad</th>
                <th class="text-end">Subtotal</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in items)
            {
                <tr>
                    <td>
                        <div>@item.Nombre</div>
                        <div class="text-body-secondary small">@item.Codigo</div>
                    </td>
                    <td class="text-end">$@item.PrecioUnitario.ToString("N0", Cultura)</td>
                    <td>
                        <input type="number" class="form-control form-control-sm"
                               min="1" max="@item.StockDisponible"
                               value="@item.Cantidad"
                               @onchange="e => CambiarCantidadAsync(item.ProductoId, e.Value?.ToString())" />
                    </td>
                    <td class="text-end">$@item.Subtotal.ToString("N0", Cultura)</td>
                    <td class="text-end">
                        <button class="btn btn-sm btn-outline-danger"
                                @onclick="() => QuitarAsync(item.ProductoId)">
                            Quitar
                        </button>
                    </td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr>
                <th colspan="3" class="text-end">Total</th>
                <th class="text-end fs-5">$@Total.ToString("N0", Cultura)</th>
                <th></th>
            </tr>
        </tfoot>
    </table>

    @if (error is not null)
    {
        <div class="alert alert-danger" role="alert">@error</div>
    }

    <AuthorizeView>
        <Authorized>
            <button class="btn btn-success" disabled="@comprando" @onclick="ConfirmarAsync">
                @(comprando ? "Procesando..." : "Confirmar compra")
            </button>
        </Authorized>
        <NotAuthorized>
            <div class="alert alert-info">
                Necesitas <a href="login">iniciar sesión</a> para confirmar la compra.
            </div>
        </NotAuthorized>
    </AuthorizeView>

    <button class="btn btn-outline-secondary ms-2" @onclick="VaciarAsync">Vaciar carrito</button>
}

@code {
    private static readonly System.Globalization.CultureInfo Cultura = new("es-CO");

    private List<ItemCarrito> items = new();
    private string? error;
    private bool comprando;

    private decimal Total => items.Sum(i => i.Subtotal);

    protected override async Task OnInitializedAsync()
    {
        CarritoServicio.Cambio += RefrescarAsync;

        await RefrescarAsync();
    }

    private async Task RefrescarAsync()
    {
        items = await CarritoServicio.ObtenerAsync();

        await InvokeAsync(StateHasChanged);
    }

    private async Task CambiarCantidadAsync(int productoId, string? valor)
    {
        if (int.TryParse(valor, out var cantidad))
            await CarritoServicio.CambiarCantidadAsync(productoId, cantidad);
    }

    private async Task QuitarAsync(int productoId) =>
        await CarritoServicio.QuitarAsync(productoId);

    private async Task VaciarAsync() =>
        await CarritoServicio.VaciarAsync();

    private async Task ConfirmarAsync()
    {
        error = null;
        comprando = true;

        try
        {
            var pedido = await CarritoServicio.ConstruirPedidoAsync();

            var venta = await VentaApi.ComprarAsync(pedido);

            await CarritoServicio.VaciarAsync();

            Navegador.NavigateTo($"/compra/{venta.Id}");
        }
        catch (ApiException ex)
        {
            error = ex.Message;

            // Si el stock cambió, el carrito puede estar desactualizado.
            await RefrescarAsync();
        }
        catch (HttpRequestException)
        {
            error = "No se pudo conectar con el servidor.";
        }
        finally
        {
            comprando = false;
        }
    }

    public void Dispose()
    {
        CarritoServicio.Cambio -= RefrescarAsync;
    }
}
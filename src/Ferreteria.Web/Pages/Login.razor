@page "/login"
@inject IAuthApi AuthApi
@inject JwtAuthenticationStateProvider AuthProvider
@inject NavigationManager Navegador

<PageTitle>Iniciar sesión</PageTitle>

<div class="row justify-content-center">
    <div class="col-md-5">
        <h1>Iniciar sesión</h1>

        <EditForm Model="@modelo" OnValidSubmit="@IniciarSesionAsync" FormName="login">
            <DataAnnotationsValidator />

            <div class="mb-3">
                <label class="form-label" for="correo">Correo</label>
                <InputText id="correo" class="form-control" @bind-Value="modelo.Correo" autocomplete="username" />
                <ValidationMessage For="@(() => modelo.Correo)" />
            </div>

            <div class="mb-3">
                <label class="form-label" for="password">Contraseña</label>
                <InputText id="password" type="password" class="form-control"
                           @bind-Value="modelo.Password" autocomplete="current-password" />
                <ValidationMessage For="@(() => modelo.Password)" />
            </div>

            @if (error is not null)
            {
                <div class="alert alert-danger" role="alert">@error</div>
            }

            <button type="submit" class="btn btn-primary" disabled="@enviando">
                @(enviando ? "Entrando..." : "Entrar")
            </button>
        </EditForm>

        <p class="mt-3">
            ¿No tienes cuenta? <a href="registro">Regístrate</a>
        </p>
    </div>
</div>

@code {
    private readonly LoginRequest modelo = new();
    private string? error;
    private bool enviando;

    private async Task IniciarSesionAsync()
    {
        error = null;
        enviando = true;

        try
        {
            var sesion = await AuthApi.LoginAsync(modelo);

            await AuthProvider.MarcarComoAutenticadoAsync(sesion);

            Navegador.NavigateTo(sesion.Rol == "Admin" ? "/admin/productos" : "/");
        }
        catch (ApiException ex)
        {
            error = ex.Message;
        }
        catch (HttpRequestException)
        {
            error = "No se pudo conectar con el servidor.";
        }
        finally
        {
            enviando = false;
        }
    }
}
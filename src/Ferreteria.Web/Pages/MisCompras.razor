@page "/mis-compras"
@attribute [Authorize]
@inject IVentaApi VentaApi

<PageTitle>Mis compras</PageTitle>

<h1>Mis compras</h1>

@if (error is not null)
{
    <div class="alert alert-danger" role="alert">@error</div>
}

@if (cargando)
{
    <p><em>Cargando...</em></p>
}
else
{
    <TablaVentas Ventas="@ventas"
                 MostrarCliente="false"
                 TextoVacio="Todavía no has hecho ninguna compra." />
}

@code {
    private List<VentaDto> ventas = new();
    private bool cargando = true;
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            ventas = await VentaApi.MisComprasAsync();
        }
        catch (ApiException ex)
        {
            error = ex.Message;
        }
        finally
        {
            cargando = false;
        }
    }
}
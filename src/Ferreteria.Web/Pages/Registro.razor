@page "/registro"
@inject IAuthApi AuthApi
@inject JwtAuthenticationStateProvider AuthProvider
@inject NavigationManager Navegador

<PageTitle>Crear cuenta</PageTitle>

<div class="row justify-content-center">
    <div class="col-md-7">
        <h1>Crear cuenta</h1>
        <p class="text-body-secondary">Registrate para comprar y ver el historial de tus pedidos.</p>

        <EditForm Model="@modelo" OnValidSubmit="@RegistrarAsync" FormName="registro">
            <DataAnnotationsValidator />

            <h5 class="mt-4">Datos de acceso</h5>

            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label" for="correo">Correo</label>
                    <InputText id="correo" class="form-control"
                               @bind-Value="modelo.Correo" autocomplete="username" />
                    <ValidationMessage For="@(() => modelo.Correo)" />
                </div>

                <div class="col-md-6">
                    <label class="form-label" for="password">Contraseña</label>
                    <InputText id="password" type="password" class="form-control"
                               @bind-Value="modelo.Password" autocomplete="new-password" />
                    <ValidationMessage For="@(() => modelo.Password)" />
                    <div class="form-text">Mínimo 8 caracteres.</div>
                </div>
            </div>

            <h5 class="mt-4">Tus datos</h5>

            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label" for="nombre">Nombre</label>
                    <InputText id="nombre" class="form-control"
                               @bind-Value="modelo.Nombre" autocomplete="given-name" />
                    <ValidationMessage For="@(() => modelo.Nombre)" />
                </div>

                <div class="col-md-6">
                    <label class="form-label" for="apellido">Apellido</label>
                    <InputText id="apellido" class="form-control"
                               @bind-Value="modelo.Apellido" autocomplete="family-name" />
                    <ValidationMessage For="@(() => modelo.Apellido)" />
                </div>

                <div class="col-md-6">
                    <label class="form-label" for="documento">Documento</label>
                    <InputText id="documento" class="form-control" @bind-Value="modelo.Documento" />
                    <ValidationMessage For="@(() => modelo.Documento)" />
                </div>

                <div class="col-md-6">
                    <label class="form-label" for="telefono">Teléfono <span class="text-body-secondary">(opcional)</span></label>
                    <InputText id="telefono" class="form-control"
                               @bind-Value="modelo.Telefono" autocomplete="tel" />
                    <ValidationMessage For="@(() => modelo.Telefono)" />
                </div>

                <div class="col-12">
                    <label class="form-label" for="direccion">Dirección <span class="text-body-secondary">(opcional)</span></label>
                    <InputText id="direccion" class="form-control"
                               @bind-Value="modelo.Direccion" autocomplete="street-address" />
                    <ValidationMessage For="@(() => modelo.Direccion)" />
                </div>
            </div>

            @if (error is not null)
            {
                <div class="alert alert-danger mt-3" role="alert">@error</div>
            }

            <button type="submit" class="btn btn-primary mt-4" disabled="@enviando">
                @(enviando ? "Creando cuenta..." : "Crear cuenta")
            </button>
        </EditForm>

        <p class="mt-3">
            ¿Ya tienes cuenta? <a href="login">Inicia sesión</a>
        </p>
    </div>
</div>

@code {
    private readonly RegistroRequest modelo = new();
    private string? error;
    private bool enviando;

    private async Task RegistrarAsync()
    {
        error = null;
        enviando = true;

        try
        {
            // La API devuelve el token igual que el login: queda con sesión iniciada.
            var sesion = await AuthApi.RegistrarAsync(modelo);

            await AuthProvider.MarcarComoAutenticadoAsync(sesion);

            Navegador.NavigateTo("/catalogo");
        }
        catch (ApiException ex)
        {
            error = ex.Message;
        }
        catch (HttpRequestException)
        {
            error = "No se pudo conectar con el servidor.";
        }
        finally
        {
            enviando = false;
        }
    }
}
